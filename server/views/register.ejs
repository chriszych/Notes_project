<%- include('partials/header') %>

<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">

      <!-- Karta rejestracji -->
      <div class="card mb-4">
        <div class="card-body p-4">

          <h2 class="card-title text-center mb-4">
            <i class="fas fa-user-plus mb-2"></i><br>
            Rejestracja
          </h2>

          <!-- Komunikaty (błędy/sukces) -->
          <div id="message" class="alert alert-danger mb-3" style="display: none;" role="alert"></div>

          <form id="register-form">
            <div class="mb-3">
              <label for="email" class="form-label">Adres e-mail</label>
              <input type="email" class="form-control" id="email" name="username" placeholder="nazwa@przyklad.pl" required>
            </div>

            <div class="mb-3">
              <label for="password" class="form-label">Hasło</label>
              <input type="password" class="form-control" id="password" name="password" placeholder="••••••••" required>
            </div>

            <div class="d-grid gap-2 mt-4">
              <button type="submit" class="btn btn-dark">
                <i class="fas fa-user-check"></i> Zarejestruj się
              </button>
            </div>
          </form>

          <hr class="my-4">

          <!-- Nawigacja pomocnicza -->
          <div class="d-flex justify-content-between align-items-center">
            <a href="/" class="btn btn-outline-dark btn-sm">
              <i class="fas fa-arrow-left"></i> Strona główna
            </a>
            <a href="/login" class="btn btn-link text-dark text-decoration-none btn-sm">
              Masz już konto? Zaloguj się <i class="fas fa-sign-in-alt"></i>
            </a>
          </div>

        </div>
      </div>

    </div>
  </div>
</div>

<script>
  const registerForm = document.getElementById("register-form");

  registerForm.addEventListener('submit', async (e) => {
    e.preventDefault();

    const messageDiv = document.getElementById('message');
    const emailInput = document.getElementById('email').value;
    const passwordInput = document.getElementById('password').value;

    // Resetowanie widoczności i klas komunikatu
    messageDiv.style.display = 'none';
    messageDiv.innerText = '';
    messageDiv.className = 'alert alert-danger mb-3';

    try {
      const response = await fetch('/api/register', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        credentials: 'include',
        body: JSON.stringify({ username: emailInput, password: passwordInput })
      });

      const result = await response.json();

      if (response.ok && result.success) {
        registerForm.reset();
        messageDiv.innerText = result.message || 'Konto zostało pomyślnie utworzone!';
        messageDiv.className = 'alert alert-success mb-3';
        messageDiv.style.display = 'block';
      } else {
        messageDiv.innerText = result.message || 'Wystąpił błąd podczas rejestracji.';
        messageDiv.style.display = 'block';
      }
    } catch (err) {
      console.error('Błąd rejestracji:', err);
      messageDiv.innerText = 'Wystąpił problem z połączeniem z serwerem.';
      messageDiv.style.display = 'block';
    }
  });
</script>

<%- include('partials/footer') %>